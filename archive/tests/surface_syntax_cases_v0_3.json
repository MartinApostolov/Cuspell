{
  "version": "0.3",
  "cases": [
    {
      "id": "S001",
      "source": "!Move This Here.",
      "expected": "Move(This,Here)",
      "status": "valid",
      "purpose": "Ordinary whitespace is normal token separation."
    },
    {
      "id": "S002",
      "source": "!Move|This|Here.",
      "expected": "Move(This,Here)",
      "status": "valid",
      "purpose": "Whole-expression pipe binding is an explicit equivalent."
    },
    {
      "id": "S003",
      "source": "!Move|This Here.",
      "status": "invalid",
      "purpose": "Hard-bound Move(This) closes before outer Here."
    },
    {
      "id": "S004",
      "source": "SolidWater This.",
      "expected": "InstanceOf(This,SolidWater)",
      "status": "valid",
      "purpose": "Adjacency remains lexical compound formation."
    },
    {
      "id": "S005",
      "source": "!If Life This EndLife This.",
      "expected": "If(Life(This),End(Life(This)))",
      "status": "valid",
      "purpose": "Typed recursive nesting across spaces."
    },
    {
      "id": "S006",
      "source": "!If Life|This EndLife|This.",
      "expected": "If(Life(This),End(Life(This)))",
      "status": "valid",
      "purpose": "Mixed ordinary tokens and hard-bound argument groups."
    },
    {
      "id": "S007",
      "source": "All [a:Human] Life $a.",
      "status": "valid",
      "purpose": "Binder scope across ordinary token stream."
    },
    {
      "id": "S008",
      "source": "!Sequence {Move This Here,EndLife Self}.",
      "status": "valid",
      "purpose": "Collection items use normal whitespace syntax."
    },
    {
      "id": "S009",
      "source": "!Move This :path ThisPath.",
      "status": "valid",
      "purpose": "Named role can skip optional positional goal."
    },
    {
      "id": "S010",
      "source": "!Preserve Volume This Change This Density Multiply @@ BeforeValue Density This.",
      "status": "valid",
      "purpose": "Deep flat typed parse needs no pipe or parentheses."
    },
    {
      "id": "S011",
      "source": "!Move|This|Here EndLife Self.",
      "status": "invalid",
      "purpose": "Whitespace after a complete hard group does not imply Sequence."
    },
    {
      "id": "S012",
      "source": "Move | This | Here.",
      "expected": "Move(This,Here)",
      "status": "valid",
      "purpose": "Spaces around pipe are ignored."
    }
  ]
}
