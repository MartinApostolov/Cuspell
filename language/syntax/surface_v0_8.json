{
  "version": "0.8",
  "status": "canonical-working-reference",
  "separators": {
    "token_separator": "whitespace",
    "group_open": "(",
    "group_close": ")",
    "collection_open": "{",
    "collection_close": "}",
    "collection_separator": ",",
    "quotation_open": "«",
    "quotation_close": "»",
    "sentence_terminators": {
      ".": "assertion",
      "?": "question",
      "!": "command"
    }
  },
  "adjacency": {
    "rule": "Direct adjacency first resolves exact roots and licensed lexical compounds; otherwise concatenated registered roots may form one complete uniquely typed tight local application.",
    "resolution_order": [
      "exact_registered_root",
      "licensed_lexical_compound",
      "unique_typed_tight_application"
    ],
    "examples": {
      "MatterSelf": "Matter(Self)",
      "LifeThis": "Life(This)",
      "DensityThis": "Density(This)",
      "SolidMatter": "registered lexical compound: Solid-restricted Matter"
    },
    "ambiguity_policy": "reject-distinct-normal-forms"
  },
  "whitespace": {
    "significant": true,
    "rule": "Whitespace separates larger written phrase units. Typed prefix parsing determines application boundaries across those units.",
    "adds_semantics": false,
    "linebreak_is_whitespace": true
  },
  "parentheses": {
    "canonical_style": false,
    "rule": "Strong fallback grouping for ambiguous/debugging cases; ordinary prose should remain flat.",
    "mana_cost": 0,
    "player_facing_fallback": true
  },
  "ordinary_parsing": {
    "strategy": "typed-prefix-recursive",
    "full_consumption_required": true,
    "ambiguity_policy": "reject-distinct-normal-forms",
    "canonical_examples": [
      "MatterSelf.",
      "LifeThis?",
      "Move This Here!",
      "Move This _ _ ThisPath!",
      "LifeThis Or MagicThis.",
      "Concurrent MoveSelfHere MoveYouThere!",
      "If LifeThis EndLifeThis!",
      "More Evaluate MatterSelf Evaluate ThingSelf."
    ]
  },
  "binders": {
    "declaration_syntax": "name:Domain",
    "reference_syntax": "$name",
    "legacy_bracket_form_accepted": true,
    "mana_cost_for_name_and_punctuation": 0
  },
  "collections": {
    "syntax": "{item,item,...}",
    "mana_cost_for_delimiters": 0,
    "canonical_for_variadic_heads": true
  },
  "quotation": {
    "syntax": "«... »",
    "nested": true,
    "exact_sign_content": true,
    "punctuation_inside_is_literal": true,
    "pipe_normalization_inside": false,
    "mana_cost_for_delimiters": 0,
    "old_name_semantic_reading": "registered historical Old Names only",
    "new_name_semantic_reading": "Sign/Name reference only; no magical macro expansion"
  },
  "style": {
    "target": "flat foreign-language prose, not visible AST notation",
    "prefer": [
      "tight local adjacency",
      "ordinary whitespace"
    ],
    "fallback": [
      "parentheses"
    ],
    "debug_only": [
      "pipe hard binding"
    ]
  },
  "sentence_mood": {
    "rule": "The final punctuation both terminates the sentence and marks its mood.",
    "assertion": ".",
    "question": "?",
    "command": "!",
    "leading_mood_markers_canonical": false,
    "legacy_prefix_compatibility": true,
    "mana_cost": 0,
    "examples": [
      "MatterSelf.",
      "LifeThis?",
      "MoveThisHere!"
    ]
  },
  "infix_operators": {
    "And": {
      "operands": [
        "Proposition",
        "EventSpec"
      ],
      "associative": true,
      "canonical": true,
      "mixed_with_Or": "explicit_grouping_required"
    },
    "Or": {
      "operands": [
        "Proposition"
      ],
      "associative": true,
      "canonical": true,
      "mixed_with_And": "explicit_grouping_required"
    }
  },
  "sequence_surface": {
    "start": "Sequence",
    "item_type": "EventSpec",
    "implicit_end": "sentence boundary",
    "explicit_end": "SequenceEnd",
    "explicit_end_required": "only when later material follows before sentence end",
    "explicit_end_mana_cost": 0,
    "legacy_collection_form_accepted": true
  },
  "concurrent_surface": {
    "start": "Concurrent",
    "item_type": "EventSpec",
    "implicit_end": "sentence boundary",
    "explicit_end": "ConcurrentEnd",
    "explicit_end_required": "only when later material follows before sentence end",
    "explicit_end_mana_cost": 0,
    "legacy_collection_form_accepted": true
  },
  "optional_arguments": {
    "omission_marker": "_",
    "rule": "The omission marker advances over exactly one current optional frame slot without binding a semantic value. Frame order determines which slot is omitted.",
    "allowed_only_for_optional_slot": true,
    "repeatable": true,
    "mana_cost": 0,
    "named_role_markers_canonical": false
  },
  "debug_compatibility": {
    "pipe_binding": {
      "connector": "|",
      "player_facing": false,
      "debug_only": true,
      "legacy_compatibility": true,
      "rule": "A maximal pipe-connected token group is parsed as one hard-bound expression for parser debugging and historical compatibility only.",
      "mana_cost": 0
    }
  }
}
